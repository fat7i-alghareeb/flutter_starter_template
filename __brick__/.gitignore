# =============================================================================
# Generated code
# -----------------------------------------------------------------------------
# This project COMMITS generated Dart (*.g.dart, *.freezed.dart,
# injectable.config.dart, app_strings.g.dart, assets.gen.dart) so a fresh clone
# builds without running build_runner first. Uncomment below only if the team
# decides to generate on every checkout instead.
#
# **/*.g.dart
# **/*.freezed.dart
# lib/core/injection/injectable.config.dart
#
# NEVER ignore objectbox-model.json: it stores entity/property UIDs and losing
# it corrupts existing on-device databases.
# =============================================================================
lib/objectbox.g.dart.bak

